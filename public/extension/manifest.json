{
  "manifest_version": 3,
  "name": "Elyx Vault Extension",
  "version": "1.4.1",
  "description": "Password vault with client-side credential encryption and origin-bound autofill.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://elyx-vault.web.app/*",
      "https://elyx-vault.firebaseapp.com/*"
    ]
  },
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "securityPolicy.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
