rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeUser(uid) {
      return request.auth != null && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/userAccess/$(uid))
        && firestore.get(/databases/(default)/documents/userAccess/$(uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/userAccess/$(uid)).data.role in ['owner', 'manager', 'member', 'viewer']
        && firestore.get(/databases/(default)/documents/userAccess/$(uid)).data.businessId is string
        && firestore.get(/databases/(default)/documents/userAccess/$(uid)).data.businessId.size() > 0;
    }
    match /media/{uid}/{allPaths=**} { allow read, write: if activeUser(uid); }
    match /music/{uid}/{allPaths=**} { allow read, write: if activeUser(uid); }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
