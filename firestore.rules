rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accessPath() { return /databases/$(database)/documents/userAccess/$(request.auth.uid); }
    function hasAccess() {
      return signedIn() && exists(accessPath()) && get(accessPath()).data.status == 'active'
        && get(accessPath()).data.role in ['owner', 'manager', 'member', 'viewer']
        && get(accessPath()).data.businessId is string && get(accessPath()).data.businessId.size() > 0;
    }
    function access() { return get(accessPath()).data; }
    function member(businessId) { return hasAccess() && access().businessId == businessId; }
    function admin(businessId) { return member(businessId) && access().role in ['owner', 'manager']; }
    function canGrant(role, businessId) { return admin(businessId) && role in ['owner', 'manager', 'member', 'viewer'] && (role != 'owner' || access().role == 'owner'); }
    function canEdit(businessId) { return member(businessId) && access().role in ['owner', 'manager', 'member']; }
    function email() { return signedIn() && request.auth.token.email is string ? request.auth.token.email.lower() : ''; }
    function verified() { return signedIn() && request.auth.token.email_verified == true && email() != ''; }
    function own(data) { return hasAccess() && data.uid == request.auth.uid; }
    function invitationPath() { return /databases/$(database)/documents/invitations/$(email()); }
    function claimedInvitation(data) {
      return verified() && exists(invitationPath())
        && get(invitationPath()).data.status in ['pending', 'approved']
        && get(invitationPath()).data.email.lower() == email()
        && data.email == email() && data.status == 'active'
        && data.role in ['owner', 'manager', 'member', 'viewer']
        && data.role == get(invitationPath()).data.role
        && data.businessId == get(invitationPath()).data.businessId
        && getAfter(invitationPath()).data.status == 'accepted'
        && getAfter(invitationPath()).data.acceptedBy == request.auth.uid;
    }
    match /businesses/{id} { allow read: if member(id); allow write: if false; }
    match /userAccess/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || admin(resource.data.businessId));
      allow list: if admin(resource.data.businessId);
      allow create: if signedIn() && (
        (canGrant(request.resource.data.role, request.resource.data.businessId) && request.resource.data.status in ['active', 'pending'])
        || (uid == request.auth.uid && claimedInvitation(request.resource.data))
      );
      allow update: if hasAccess() && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.email == resource.data.email && (
          (canGrant(request.resource.data.role, resource.data.businessId)
            && (resource.data.role != 'owner' || access().role == 'owner')
            && request.resource.data.status in ['active', 'pending', 'disabled', 'revoked'])
          || (uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if admin(resource.data.businessId) && (resource.data.role != 'owner' || access().role == 'owner');
    }
    match /invitations/{id} {
      allow read: if admin(resource.data.businessId) || (verified() && resource.data.email.lower() == email());
      allow create: if canGrant(request.resource.data.role, request.resource.data.businessId)
        && request.resource.data.status in ['pending', 'approved'] && request.resource.data.email == id;
      allow delete: if admin(resource.data.businessId) && (resource.data.role != 'owner' || access().role == 'owner');
      allow update: if (
        canGrant(request.resource.data.role, resource.data.businessId)
        && (resource.data.role != 'owner' || access().role == 'owner')
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.email == resource.data.email
      ) || (
        verified() && id == email() && resource.data.email.lower() == email()
        && resource.data.status in ['pending', 'approved'] && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && getAfter(accessPath()).data.role == resource.data.role
        && getAfter(accessPath()).data.businessId == resource.data.businessId
        && getAfter(accessPath()).data.status == 'active'
      );
    }
    match /{collection}/{id} {
      allow read: if collection in ['projects', 'minecraft_vault'] && member(resource.data.businessId);
      allow create: if collection in ['projects', 'minecraft_vault'] && canEdit(request.resource.data.businessId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if collection in ['projects', 'minecraft_vault'] && canEdit(resource.data.businessId)
        && request.resource.data.businessId == resource.data.businessId && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if collection in ['projects', 'minecraft_vault'] && canEdit(resource.data.businessId);
      allow read: if collection in ['workspace_presets', 'workspace_links', 'workspace_sessions', 'workspace_activity', 'devices', 'terminal_sessions', 'music_vault', 'music_folders', 'media_vault', 'user_notes'] && own(resource.data);
      allow create: if collection in ['workspace_presets', 'workspace_links', 'workspace_sessions', 'workspace_activity', 'music_vault', 'music_folders', 'media_vault', 'user_notes'] && own(request.resource.data);
      allow delete: if collection in ['workspace_presets', 'workspace_links', 'workspace_sessions', 'workspace_activity', 'music_vault', 'music_folders', 'media_vault', 'user_notes'] && own(resource.data);
      allow update: if collection in ['workspace_presets', 'workspace_links', 'workspace_sessions', 'workspace_activity', 'music_vault', 'music_folders', 'media_vault', 'user_notes']
        && own(resource.data) && request.resource.data.uid == resource.data.uid
        && request.resource.data.get('businessId', null) == resource.data.get('businessId', null);
    }
    match /devices/{id} {
      allow create: if own(request.resource.data) && access().role in ['owner', 'manager', 'member'];
      allow update: if own(resource.data) && access().role in ['owner', 'manager', 'member']
        && request.resource.data.uid == resource.data.uid;
      allow delete: if own(resource.data) && access().role in ['owner', 'manager', 'member'];
    }
    match /terminal_sessions/{id} {
      allow create: if own(request.resource.data) && access().role in ['owner', 'manager'];
      allow update: if own(resource.data) && access().role in ['owner', 'manager']
        && request.resource.data.uid == resource.data.uid;
      allow delete: if own(resource.data) && access().role in ['owner', 'manager'];
    }
    match /security_events/{id} {
      allow read: if own(resource.data);
      allow create: if own(request.resource.data);
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
