rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accessPath() {
      return /databases/$(database)/documents/userAccess/$(request.auth.uid);
    }

    function hasAccess() {
      return signedIn() && exists(accessPath());
    }

    function access() {
      return get(accessPath()).data;
    }

    function isManager() {
      return hasAccess() && access().role == 'manager';
    }

    function isBusinessMember(businessId) {
      return hasAccess() && access().businessId == businessId;
    }

    function canEditBusiness(businessId) {
      return isBusinessMember(businessId) && access().role in ['manager', 'member'];
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    match /businesses/{businessId} {
      allow read: if isBusinessMember(businessId);
      allow write: if false;
    }

    match /userAccess/{uid} {
      allow read: if signedIn() && (
        uid == request.auth.uid
        || (isManager() && resource.data.businessId == access().businessId)
      );

      // A user may only claim the exact role/business from a pending invitation.
      allow create: if signedIn()
        && uid == request.auth.uid
        && verifiedEmail()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role in ['member', 'viewer']
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.status == 'pending'
        && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.email == request.auth.token.email.lower()
        && request.resource.data.businessId == get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.businessId
        && request.resource.data.role == get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.role
        && request.resource.data.invitedBy == get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.createdBy;
      allow update, delete: if false;
    }

    match /invitations/{email} {
      allow get: if signedIn() && (
        (verifiedEmail() && email == request.auth.token.email.lower())
        || (isManager() && resource.data.businessId == access().businessId)
      );
      allow list: if isManager() && resource.data.businessId == access().businessId;

      allow create: if isManager()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.businessId == access().businessId
        && request.resource.data.role in ['member', 'viewer']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if (
        isManager()
        && resource.data.businessId == access().businessId
        && resource.data.status == 'pending'
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.email == resource.data.email
        && request.resource.data.role in ['member', 'viewer']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
      ) || (
        verifiedEmail()
        && email == request.auth.token.email.lower()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.businessId == resource.data.businessId
        && getAfter(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.role == resource.data.role
      );
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if isBusinessMember(resource.data.businessId);
      allow create: if canEditBusiness(request.resource.data.businessId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if canEditBusiness(resource.data.businessId)
        && request.resource.data.businessId == resource.data.businessId;
      allow delete: if canEditBusiness(resource.data.businessId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
