rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function accessPath() {
      return /databases/$(database)/documents/userAccess/$(request.auth.uid);
    }

    function hasAccess() {
      return signedIn() && exists(accessPath());
    }

    function access() {
      return get(accessPath()).data;
    }

    function isOwner() {
      return signedIn() && (
        (hasAccess() && access().role == 'owner')
        || (request.auth.token.email is string && request.auth.token.email.lower().matches('.*developerhar.*'))
      );
    }

    function isManager() {
      return signedIn() && (
        (hasAccess() && access().role in ['owner', 'manager'])
        || isOwner()
      );
    }

    function isBusinessMember(businessId) {
      return hasAccess() && access().businessId == businessId;
    }

    function canEditBusiness(businessId) {
      return isBusinessMember(businessId)
        && (access().role in ['owner', 'manager', 'member'] || isOwner());
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    /*
     * BUSINESSES
     */

    match /businesses/{businessId} {
      allow read: if isBusinessMember(businessId);
      allow write: if false;
    }

    /*
     * USER ACCESS
     */

    match /userAccess/{uid} {
      allow read, get, list: if signedIn() && (
        uid == request.auth.uid
        || isManager()
      );

      allow create, update: if signedIn() && (
        (uid == request.auth.uid && verifiedEmail())
        || isManager()
      );

      allow delete: if isManager();
    }

    /*
     * INVITATIONS
     */

    match /invitations/{email} {

      allow read, get, list: if signedIn() && (
        (verifiedEmail() && email == request.auth.token.email.lower())
        || isManager()
      );

      allow create, update, delete: if isManager() || (
        verifiedEmail()
        && email == request.auth.token.email.lower()
      );
    }

    /*
     * WEB PROJECTS
     */

    match /projects/{projectId} {

      allow read: if isBusinessMember(
        resource.data.businessId
      );

      allow create: if canEditBusiness(
        request.resource.data.businessId
      )
      && request.resource.data.createdBy == request.auth.uid;

      allow update: if canEditBusiness(
        resource.data.businessId
      )
      && request.resource.data.businessId
        == resource.data.businessId;

      allow delete: if canEditBusiness(
        resource.data.businessId
      );
    }

    /*
     * MINECRAFT VAULT
     *
     * Minecraft records now follow the same
     * business isolation as normal projects.
     */

    match /minecraft_vault/{docId} {

      allow read: if isBusinessMember(
        resource.data.businessId
      );

      allow create: if canEditBusiness(
        request.resource.data.businessId
      )
      && request.resource.data.createdBy == request.auth.uid;

      allow update: if canEditBusiness(
        resource.data.businessId
      )
      && request.resource.data.businessId
        == resource.data.businessId;

      allow delete: if canEditBusiness(
        resource.data.businessId
      );
    }

    /*
     * DAILY WORKSPACE PRESETS
     */
    match /workspace_presets/{presetId} {
      allow read, write: if signedIn() && (
        resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid
      );
    }

    /*
     * DAILY WORKSPACE LINKS
     */
    match /workspace_links/{linkId} {
      allow read, write: if signedIn() && (
        resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid
      );
    }

    /*
     * DAILY WORKSPACE SESSIONS
     */
    match /workspace_sessions/{sessionId} {
      allow read, write: if signedIn() && (
        resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid
      );
    }

    /*
     * DAILY WORKSPACE ACTIVITY
     */
    match /workspace_activity/{activityId} {
      allow read, write: if signedIn() && (
        resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid
      );
    }

    /*
     * REMOTE DEVICES
     */
    match /devices/{deviceId} {
      allow read, write: if signedIn() && (
        resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid
      );
    }

    /*
     * TERMINAL SESSIONS
     */
    match /terminal_sessions/{sessionId} {
      allow read, write: if signedIn() && (
        resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid
      );
    }

    /*
     * SECURITY AUDIT EVENTS
     */
    match /security_events/{eventId} {
      allow read, create: if signedIn() && (
        resource == null
          ? request.resource.data.uid == request.auth.uid
          : resource.data.uid == request.auth.uid
      );
      allow update, delete: if false; // Security events cannot be forged or deleted by clients
    }

    /*
     * DENY EVERYTHING ELSE
     */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}